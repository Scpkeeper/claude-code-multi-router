{
  "LOG": true,
  "HOST": "127.0.0.1",
  "PORT": 3456,
  "API_TIMEOUT_MS": 600000,
  "Providers": [
    {
      "name": "openrouter",
      "api_base_url": "https://openrouter.ai/api/v1/chat/completions",
      "api_key": "$OPENROUTER_API_KEY",
      "models": [
        "anthropic/claude-opus-5.5",
        "anthropic/claude-sonnet-5.5",
        "moonshotai/kimi-k3",
        "deepseek/deepseek-v4-flash"
      ],
      "transformer": {
        "use": [
          "openrouter"
        ]
      }
    }
  ],
  "Router": {
    "default": "openrouter,anthropic/claude-sonnet-5.5",
    "background": "openrouter,deepseek/deepseek-v4-flash",
    "think": "openrouter,anthropic/claude-opus-5.5",
    "longContext": "openrouter,moonshotai/kimi-k3"
  },
  "CUSTOM_ROUTER_PATH": "~/.claude-code-router/custom-router.js"
}
